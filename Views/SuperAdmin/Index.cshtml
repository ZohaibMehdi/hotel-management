@model IReadOnlyList<TestApplication.Models.Tenant>
@{
    ViewData["Title"] = "Tenant management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Tenant management</h1>
        <p class="text-muted mb-0">Create and manage hotel tenant accounts.</p>
    </div>
    <a class="btn btn-primary" asp-action="CreateTenant">Onboard tenant</a>
</div>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success" role="status">@statusMessage</div>
}

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Tenant</th>
                <th>Contact</th>
                <th>Email / login</th>
                <th>Created (UTC)</th>
                <th>Updated (UTC)</th>
                <th>Status</th>
                <th><span class="visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var tenant in Model)
        {
            <tr>
                <td><strong>@tenant.Name</strong><br /><span class="text-muted">@tenant.Address</span></td>
                <td>@tenant.ContactNumber</td>
                <td>@tenant.Email</td>
                <td>@tenant.CreatedOn.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@tenant.UpdatedOn.ToString("yyyy-MM-dd HH:mm")</td>
                <td><span class="badge @(tenant.IsActive ? "text-bg-success" : "text-bg-secondary")">@(tenant.IsActive ? "Active" : "Inactive")</span></td>
                <td>
                    <form asp-action="ToggleTenant" asp-route-id="@tenant.Id" method="post">
                        <button type="submit" class="btn btn-sm @(tenant.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                            @(tenant.IsActive ? "Deactivate" : "Activate")
                        </button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="7" class="text-center text-muted py-4">No tenants have been onboarded yet.</td></tr>
        }
        </tbody>
    </table>
</div>
