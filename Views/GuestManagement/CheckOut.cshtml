@model TestApplication.Models.CheckOutViewModel
@{
    ViewData["Title"] = "Check out guest";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <h1>Check out guest</h1>
        <p>Guest: <strong>@Model.GuestName</strong></p>
        <p>Room: <strong>@Model.RoomNumber</strong></p>
        <p>Check-in: <strong>@Model.CheckInDate.ToString("yyyy-MM-dd")</strong></p>
        <form asp-action="CheckOut" method="post">
            <input asp-for="BookingId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="CheckOutDate" class="form-label"></label>
                <input asp-for="CheckOutDate" type="date" min="@Model.CheckInDate.AddDays(1).ToString("yyyy-MM-dd")" class="form-control" />
                <span asp-validation-for="CheckOutDate" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Save check-out</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
