@model TestApplication.Models.TenantPortalViewModel
@{
    ViewData["Title"] = "Hotel workspace";
}

<h1>@Model.Tenant.Name</h1>
<p class="text-muted">Manage your hotel rooms and tenant details.</p>
<a class="btn btn-outline-primary mb-3" asp-controller="GuestManagement" asp-action="Index">Manage guests and bookings</a>

<div class="card">
    <div class="card-header">Tenant details</div>
    <dl class="card-body row mb-0">
        <dt class="col-sm-3">Address</dt>
        <dd class="col-sm-9">@Model.Tenant.Address</dd>
        <dt class="col-sm-3">Contact number</dt>
        <dd class="col-sm-9">@Model.Tenant.ContactNumber</dd>
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Tenant.Email</dd>
        <dt class="col-sm-3">Account status</dt>
        <dd class="col-sm-9">@(Model.Tenant.IsActive ? "Active" : "Inactive")</dd>
    </dl>
</div>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success mt-4" role="status">@statusMessage</div>
}

<div class="row g-4 mt-1">
    <section class="col-lg-5" aria-labelledby="add-room-heading">
        <div class="card">
            <div class="card-header"><h2 id="add-room-heading" class="h5 mb-0">Add a room</h2></div>
            <div class="card-body">
                <form asp-action="AddRoom" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="RoomNumber" class="form-label"></label>
                        <input asp-for="RoomNumber" type="number" min="1" step="1" class="form-control" />
                        <span asp-validation-for="RoomNumber" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="RoomType" class="form-label"></label>
                        <input asp-for="RoomType" type="text" class="form-control" placeholder="e.g. Single, Double, Master" />
                        <span asp-validation-for="RoomType" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Add room</button>
                </form>
            </div>
        </div>
    </section>

    <section class="col-lg-7" aria-labelledby="rooms-heading">
        <h2 id="rooms-heading" class="h4">Rooms <span class="badge text-bg-secondary">@Model.Rooms.Count</span></h2>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr><th>Room number</th><th>Room type</th></tr>
                </thead>
                <tbody>
                @foreach (var room in Model.Rooms)
                {
                    <tr><td>@room.RoomNumber</td><td>@room.RoomType</td></tr>
                }
                @if (Model.Rooms.Count == 0)
                {
                    <tr><td colspan="2" class="text-center text-muted py-4">No rooms added yet.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
